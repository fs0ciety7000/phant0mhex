---
import Public from '../layouts/Public.astro';

Astro.response.status = 404;
---
<Public title="Page introuvable — Nicolas Dessenius" noindex>
  <section class="lost wrap" aria-labelledby="h-404">
    <p class="mono muted">Erreur 404</p>
    <h1 id="h-404">404<span style="color:var(--accent)">.</span></h1>
    <p>Cette page n’existe pas, ou n’est pas encore publiée.</p>
    <div class="cta">
      <a class="btn primary" href="/">Accueil</a>
      <a class="btn" href="/projets">Projets</a>
      <a class="btn" href="/journal">Blog</a>
    </div>
  </section>
</Public>
