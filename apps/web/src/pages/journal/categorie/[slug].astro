---
import JournalList from '../../../components/JournalList.astro';
import SignalLost from '../../../components/SignalLost.astro';
import Public from '../../../layouts/Public.astro';
import { createData, pageParam } from '../../../lib/data';

const slug = Astro.params.slug ?? '';
const db = createData(Astro.locals);
const page = pageParam(Astro.url);

const [found, categories, index] = await Promise.all([db.category(slug), db.categories(), db.logIndex()]);
if (found.state === 'missing') return Astro.rewrite('/404');
const category = found.state === 'ok' ? found.value : undefined;
if (!category) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
}
const result = category
  ? await db.posts({ page, where: (f) => f('category = {:id}', { id: category.id }) })
  : { page, perPage: 12, totalItems: 0, totalPages: 0, items: [] };
if (result.totalItems > 0 && page > result.totalPages) return Astro.rewrite('/404');
const base = `/journal/categorie/${slug}`;
---
<Public
  title={category ? `${category.name} — Journal — Nicolas Dessenius` : 'Catégorie indisponible — Nicolas Dessenius'}
  description={category?.description || `Billets de la catégorie ${category?.name ?? ''} du journal.`}
  canonical={page > 1 ? `${base}?page=${page}` : base}
  noindex={!category}
>
  {
    category ? (
      <JournalList
        title={category.name}
        kicker="CATÉGORIE"
        result={result}
        index={index}
        categories={categories}
        activeCategory={category.slug}
        basePath={base}
        degraded={Astro.locals.degraded}
      />
    ) : (
      <SignalLost back={{ href: '/journal', label: 'JOURNAL' }} />
    )
  }
</Public>
