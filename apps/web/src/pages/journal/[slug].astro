---
import ArticleTools from '../../components/ArticleTools.astro';
import Prose from '../../components/Prose.astro';
import SignalLost from '../../components/SignalLost.astro';
import Public from '../../layouts/Public.astro';
import { createData } from '../../lib/data';
import { dateLong, isoDate } from '../../lib/format';
import { fileUrl, thumbSrcset } from '../../lib/pb';
import { renderMarkdown } from '../../lib/render';

const slug = Astro.params.slug ?? '';
const db = createData(Astro.locals);
const [found, index] = await Promise.all([db.post(slug), db.logIndex()]);
if (found.state === 'missing') return Astro.rewrite('/404');
const post = found.state === 'ok' ? found.value : undefined;
if (!post) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
}

const md = post ? await renderMarkdown(db, post.body ?? '') : undefined;
const pos = post ? index.findIndex((e) => e.id === post.id) : -1;
const older = pos > 0 ? index[pos - 1] : undefined;
const newer = pos >= 0 ? index[pos + 1] : undefined;
const toc = (md?.toc ?? []).filter((t) => t.depth >= 2 && t.depth <= 3);
const minutes = post?.reading_time || md?.readingTime || 0;
const category = post?.expand?.category;
const tags = post?.expand?.tags ?? [];
const cover = post?.cover ? fileUrl(post.collectionName, post.id, post.cover, '1920x0') : '';
const origin = (Astro.site ?? Astro.url).origin;
const url = `${origin}/journal/${slug}`;
const title = post ? post.seo_title || post.title : 'Billet indisponible';
const description = post ? post.seo_description || post.excerpt || undefined : undefined;

const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description: description ?? '',
      datePublished: isoDate(post.published_at),
      dateModified: isoDate(post.updated),
      inLanguage: 'fr',
      url,
      mainEntityOfPage: url,
      image: `${origin}/og/${post.slug}.png`,
      author: { '@type': 'Person', name: 'Nicolas Dessenius', url: `${origin}/` },
      ...(category ? { articleSection: category.name } : {}),
      ...(tags.length ? { keywords: tags.map((t) => t.name).join(', ') } : {}),
      ...(minutes ? { timeRequired: `PT${minutes}M` } : {}),
    }
  : undefined;
---
<Public
  title={`${title} — Blog — Nicolas Dessenius`}
  description={description}
  canonical={`/journal/${slug}`}
  image={`/og/${slug}.png`}
  type="article"
  jsonLd={jsonLd}
  noindex={!post}
  publishedTime={post ? isoDate(post.published_at) : undefined}
  modifiedTime={post ? isoDate(post.updated) : undefined}
>
  {
    !post || !md ? (
      <SignalLost back={{ href: '/journal', label: 'Blog' }} />
    ) : (
      <article class="wrap" aria-labelledby="h-art">
        <header class="doc-head">
          <nav class="crumbs mono" aria-label="Fil d’Ariane">
            <a href="/journal">Blog</a>
            {category && (
              <>
                <span aria-hidden="true">/</span>
                <a href={`/journal/categorie/${category.slug}`}>{category.name}</a>
              </>
            )}
          </nav>
          <h1 id="h-art">{post.title}</h1>
          {post.excerpt && <p class="doc-lede">{post.excerpt}</p>}
          <div class="facts-row mono">
            <time datetime={isoDate(post.published_at)}>{dateLong(post.published_at)}</time>
            {minutes > 0 && <span>{minutes} min de lecture</span>}
          </div>
          {tags.length > 0 && (
            <ul class="chips" aria-label="Étiquettes">
              {tags.map((t) => (
                <li>
                  <a class="chip" href={`/journal/tag/${t.slug}`}>#{t.name}</a>
                </li>
              ))}
            </ul>
          )}
        </header>

        {cover && (
          <figure class="doc-cover">
            <img
              src={cover}
              srcset={thumbSrcset(post.collectionName, post.id, post.cover)}
              sizes="(min-width: 1240px) 1208px, 100vw"
              alt=""
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )}

        <div class="doc-body">
          <aside class="doc-side" aria-label="Sommaire">
            {toc.length > 0 && (
              <nav class="toc">
                <p class="mono muted" style="margin:0 0 10px">Sommaire</p>
                <ol>
                  {toc.map((t) => (
                    <li class={`d${t.depth}`}>
                      <a href={`#${t.id}`}>{t.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </aside>
          <div>
            <Prose html={md.html} id="prose" />
          </div>
        </div>

        <nav class="prevnext" aria-label="Billets voisins">
          {older ? (
            <a href={`/journal/${older.slug}`} rel="prev">
              <span class="mono">← Billet précédent</span>
              <span class="t">{older.title}</span>
            </a>
          ) : (
            <a href="/journal">
              <span class="mono">← Retour</span>
              <span class="t">Tout le blog</span>
            </a>
          )}
          {newer ? (
            <a class="next" href={`/journal/${newer.slug}`} rel="next">
              <span class="mono">Billet suivant →</span>
              <span class="t">{newer.title}</span>
            </a>
          ) : (
            <a class="next" href="/journal">
              <span class="mono">Retour →</span>
              <span class="t">Tout le blog</span>
            </a>
          )}
        </nav>
        <ArticleTools />
      </article>
    )
  }
</Public>
