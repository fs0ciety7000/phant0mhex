---
import ProjectGrid from '../../components/ProjectGrid.astro';
import Public from '../../layouts/Public.astro';
import { createData } from '../../lib/data';

const db = createData(Astro.locals);
const projects = await db.projects();
---
<Public
  title="Projets — Nicolas Dessenius"
  description="Tous les projets en ligne de Nicolas Dessenius : jeux, outils, applications et créations, à Mons et ailleurs."
  canonical="/projets"
>
  <section class="wrap" aria-labelledby="h-pro">
    <header class="page-head">
      <p class="mono muted">{projects.length} projets en ligne</p>
      <h1 id="h-pro">Projets</h1>
      <p>Jeux, outils et créations, tous jouables ou utilisables aujourd’hui. Chaque fiche mène au projet en ligne.</p>
    </header>
    <div style="padding-top:32px">
      {
        projects.length > 0 ? (
          <ProjectGrid projects={projects} headingLevel={2} />
        ) : (
          <p class="empty">
            <b>{Astro.locals.degraded ? 'Projets indisponibles.' : 'Aucun projet publié.'}</b>
            {Astro.locals.degraded ? 'La base de contenu ne répond pas, réessayez dans quelques instants.' : ''}
          </p>
        )
      }
    </div>
  </section>
</Public>
