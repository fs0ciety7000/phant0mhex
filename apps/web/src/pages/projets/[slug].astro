---
import Prose from '../../components/Prose.astro';
import SignalLost from '../../components/SignalLost.astro';
import Public from '../../layouts/Public.astro';
import { createData } from '../../lib/data';
import { thumbSrcset } from '../../lib/pb';
import { projectHost, projectImage, TYPE_LABEL } from '../../lib/projects';
import { renderMarkdown } from '../../lib/render';

const slug = Astro.params.slug ?? '';
const db = createData(Astro.locals);
const projects = await db.projects();
const down = Astro.locals.degraded;
const i = projects.findIndex((p) => p.slug === slug);
const project = i >= 0 ? projects[i] : undefined;
if (!down && !project) return Astro.rewrite('/404');
if (!project) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
}

const html = project?.body?.trim() ? (await renderMarkdown(db, project.body)).html : '';
const prev = i > 0 ? projects[i - 1] : undefined;
const next = i >= 0 && i < projects.length - 1 ? projects[i + 1] : undefined;
const image = project ? projectImage(project, '1920x0') : '';
const srcset = project?.cover ? thumbSrcset(project.collectionName, project.id, project.cover) : undefined;
const host = project ? projectHost(project) : '';
const facts = project
  ? [
      ['Type', project.type ? TYPE_LABEL[project.type] : ''],
      ['Genre', project.kind],
      ['Rôle', project.role],
      ['Année', project.year],
      ['Ancrage', project.mons ? 'Mons' : ''],
    ].filter(([, v]) => v && !/^\[.*\]$/.test(v))
  : [];
---
<Public
  title={project ? `${project.title} — Projets — Nicolas Dessenius` : 'Projet indisponible — Nicolas Dessenius'}
  description={project?.summary || undefined}
  canonical={`/projets/${slug}`}
  noindex={!project}
>
  {
    !project ? (
      <SignalLost back={{ href: '/projets', label: 'Projets' }} />
    ) : (
      <article class="wrap" aria-labelledby="h-pro">
        <header class="doc-head">
          <nav class="crumbs mono" aria-label="Fil d’Ariane">
            <a href="/projets">Projets</a>
            <span aria-hidden="true">/</span>
            <span>{project.title}</span>
          </nav>
          <h1 id="h-pro">{project.title}</h1>
          {project.summary && <p class="doc-lede">{project.summary}</p>}
          {facts.length > 0 && (
            <dl class="facts-row mono">
              {facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )}
          {host && (
            <div class="cta">
              <a class="btn primary" href={project.url} rel="noopener">
                Ouvrir {host} ↗
              </a>
            </div>
          )}
        </header>
        {image && (
          <figure class="doc-cover">
            <a href={project.url || undefined} rel="noopener" tabindex="-1">
              <img
                src={image}
                srcset={srcset}
                sizes="(min-width: 1240px) 1208px, 100vw"
                alt={`Capture de ${project.title}`}
                width="960"
                height="600"
                loading="eager"
                decoding="async"
              />
            </a>
          </figure>
        )}
        {html && (
          <div class="doc-body">
            <aside class="doc-side mono muted">À propos du projet</aside>
            <div>
              <Prose html={html} />
            </div>
          </div>
        )}
        <nav class="prevnext" aria-label="Projets voisins">
          {prev ? (
            <a href={`/projets/${prev.slug}`} rel="prev">
              <span class="mono">← Précédent</span>
              <span class="t">{prev.title}</span>
            </a>
          ) : (
            <a href="/projets">
              <span class="mono">← Retour</span>
              <span class="t">Tous les projets</span>
            </a>
          )}
          {next ? (
            <a class="next" href={`/projets/${next.slug}`} rel="next">
              <span class="mono">Suivant →</span>
              <span class="t">{next.title}</span>
            </a>
          ) : (
            <a class="next" href="/projets">
              <span class="mono">Retour →</span>
              <span class="t">Tous les projets</span>
            </a>
          )}
        </nav>
      </article>
    )
  }
</Public>
