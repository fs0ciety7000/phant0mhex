---
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionHead from '../components/SectionHead.astro';
import Public from '../layouts/Public.astro';
import { createData } from '../lib/data';

const db = createData(Astro.locals);
const [site, projects, latest] = await Promise.all([db.site(), db.projects(), db.posts({ perPage: 1 })]);

const featured = projects.filter((p) => p.featured);
const catalogue = projects.filter((p) => !p.featured);
const games = projects.filter((p) => p.type === 'jeu').length;
const email = site?.email?.trim() ?? '';
const socials = (Array.isArray(site?.socials) ? site.socials : []).filter((s) => s?.label && s?.url);
const post = latest.items[0];
const origin = (Astro.site ?? Astro.url).origin;

const studios = [
  {
    name: 'CM Interactive',
    href: 'https://interactive.cardormedia.com',
    text: 'Jeux 3D, web temps réel, plateformes interactives',
  },
  {
    name: 'CM Soundworks',
    href: 'https://sound.cardormedia.com',
    text: 'Sound design, voix, musique et mixage',
  },
  {
    name: 'CM Creative Lab',
    href: 'https://creative.cardormedia.com',
    text: 'Illustration, direction artistique, lore, identité',
  },
  {
    name: 'CM Publishing',
    href: 'https://publishing.cardormedia.com',
    text: 'Édition numérique et liseuse interactive',
  },
];

const skills = [
  {
    stack: 'Godot 4 · GDScript',
    title: 'Jeux vidéo',
    text: 'Boucles de jeu, génération procédurale, systèmes de règles, narrative design, accessibilité, exports multi-plateformes.',
  },
  {
    stack: 'Go · Rust',
    title: 'Systèmes et backend',
    text: 'Serveurs multimédia, API et agents en Go. Outils bas niveau, TUI et GUI en Rust.',
  },
  {
    stack: 'TypeScript · Svelte 5 · React',
    title: 'Interfaces',
    text: 'PWA, design systems soignés, interfaces pensées pour le clavier, Three.js et shaders.',
  },
  {
    stack: 'Docker · Coolify · Cloudflare',
    title: 'Infrastructure',
    text: 'Packaging multi-arch, CI/CD, une cinquantaine de services auto-hébergés en production.',
  },
  {
    stack: 'Lore · DA · son',
    title: 'Création de mondes',
    text: 'Direction artistique, écriture, voix et musique : des univers cohérents d’un médium à l’autre.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolas Dessenius',
  alternateName: 'fs0ciety7000',
  jobTitle: 'Développeur full-stack et game developer',
  worksFor: { '@type': 'Organization', name: 'CARDOR Media', url: 'https://cardormedia.com' },
  address: { '@type': 'PostalAddress', addressLocality: 'Mons', addressCountry: 'BE' },
  url: `${origin}/`,
  ...(email ? { email: `mailto:${email}` } : {}),
  sameAs: ['https://github.com/fs0ciety7000', 'https://cardormedia.com', ...socials.map((s) => s.url)].filter(
    (u, i, a) => a.indexOf(u) === i,
  ),
};
---
<Public title="Nicolas Dessenius — développeur full-stack et game developer à Mons" canonical="/" jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="h-hero">
    <div class="wrap">
      <p class="mono muted">Mons, Belgique · fs0ciety7000</p>
      <h1 id="h-hero">Nicolas<br />Dessenius<em>.</em></h1>
      <div class="hero-row">
        <div class="cta-col" style="display:grid;gap:24px">
          <p class="lede">
            Développeur full-stack et game developer. Je conçois, code et mets en ligne des jeux, des outils et des
            mondes, du premier croquis au déploiement.
          </p>
          <div class="cta">
            <a class="btn primary" href="#projets">Voir les projets ↓</a>
            <a class="btn" href="#contact">Me contacter</a>
          </div>
        </div>
        {
          projects.length > 0 && (
            <dl class="facts">
              <div><dt>projets en ligne</dt><dd>{projects.length}</dd></div>
              <div><dt>jeux jouables</dt><dd>{games}</dd></div>
              <div><dt>studios CARDOR Media</dt><dd>{studios.length}</dd></div>
            </dl>
          )
        }
      </div>
    </div>
  </section>

  <section id="projets" class="wrap" aria-labelledby="h-sel">
    {
      featured.length > 0 && (
        <>
          <SectionHead title="Sélection" id="h-sel">
            Quelques projets qui montrent l’éventail : jeux narratifs, FPS, enquêtes, logiciel libre.
          </SectionHead>
          <div class="featured">
            {featured.map((p) => (
              <ProjectCard project={p} featured />
            ))}
          </div>
        </>
      )
    }
    <SectionHead title={featured.length ? 'Tout le catalogue' : 'Projets'} id={featured.length ? 'h-cat' : 'h-sel'}>
      Chaque carte mène à sa fiche, puis au projet en ligne.
    </SectionHead>
    {
      catalogue.length > 0 ? (
        <ProjectGrid projects={catalogue} />
      ) : (
        <p class="empty">
          <b>{Astro.locals.degraded ? 'Projets indisponibles.' : 'Aucun projet publié.'}</b>
          {Astro.locals.degraded ? 'La base de contenu ne répond pas, réessayez dans quelques instants.' : ''}
        </p>
      )
    }
  </section>

  <section id="competences" class="wrap" aria-labelledby="h-skills">
    <SectionHead title="Ce que je sais faire" id="h-skills">
      Du prototype rapide à la production : exports multi-plateformes, packaging, CI, déploiement self-hosted.
    </SectionHead>
    <div class="skills">
      {
        skills.map((s) => (
          <div class="skill">
            <span class="mono">{s.stack}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="cardor" class="band-dark" aria-labelledby="h-cardor">
    <div class="wrap">
      <div>
        <p class="mono" style="opacity:.7">Holding de divertissement · Mons</p>
        <h2 id="h-cardor">CARDOR Media</h2>
        <p>
          J’ai fondé CARDOR Media pour réunir mes projets sous un même noyau créatif : quatre studios, du jeu vidéo à
          l’édition.
        </p>
        <a class="btn" href="https://cardormedia.com" rel="noopener">cardormedia.com ↗</a>
      </div>
      <div class="studios">
        {
          studios.map((s) => (
            <a class="studio" href={s.href} rel="noopener">
              <b>{s.name}</b>
              <span>{s.text}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="wrap duo">
    <section id="journal" aria-labelledby="h-journal">
      <h2 class="label mono" id="h-journal">Blog · dernier billet</h2>
      {
        post ? (
          <PostCard post={post} />
        ) : (
          <div class="post">
            <h3>Le blog arrive.</h3>
            <p>Notes de fabrication, décisions techniques et post-mortems.</p>
          </div>
        )
      }
      <p style="margin-top:16px"><a class="go" href="/journal">Tout le blog →</a></p>
    </section>

    <section id="contact" class="contact" aria-labelledby="h-contact">
      <h2 id="h-contact">Un projet, un poste, une idée ?</h2>
      <p>Je réponds aux recrutements, aux collaborations et aux joueurs.</p>
      {
        email && (
          <div class="mail">
            <a href={`mailto:${email}`} id="mail">{email}</a>
            <button class="copy" type="button" data-copy-mail={email} hidden>Copier</button>
          </div>
        )
      }
      <ul class="links">
        <li><a href="https://github.com/fs0ciety7000" rel="noopener me">GitHub</a></li>
        <li><a href="https://cardormedia.com" rel="noopener">CARDOR Media</a></li>
        <li><a href="https://apps.cardormedia.com" rel="noopener">Tous les jeux</a></li>
        {socials
          .filter((s) => !/github\.com\/fs0ciety7000|cardormedia\.com\/?$/.test(s.url))
          .map((s) => (
            <li><a href={s.url} rel="noopener me">{s.label}</a></li>
          ))}
      </ul>
      <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
    </section>
  </div>
</Public>

<script>
  function init(): void {
    const btn = document.querySelector<HTMLButtonElement>('[data-copy-mail]');
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = '1';
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      const status = document.querySelector<HTMLElement>('[data-copy-status]');
      let ok = true;
      try {
        await navigator.clipboard.writeText(btn.dataset.copyMail ?? '');
      } catch {
        ok = false;
      }
      btn.textContent = ok ? 'Copié' : 'Échec';
      if (status) status.textContent = ok ? 'Adresse copiée.' : 'La copie a échoué.';
      setTimeout(() => (btn.textContent = 'Copier'), 1500);
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
