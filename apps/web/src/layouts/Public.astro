---
import type { ComponentProps } from 'astro/types';
import Footer from '../components/Footer.astro';
import TopBar from '../components/TopBar.astro';
import Motion from '../islands/motion/Motion.astro';
import '../styles/public.css';
// biome-ignore lint/style/useImportType: composant utilisé dans le template
import Base from './Base.astro';

type Props = ComponentProps<typeof Base>;
const props = Astro.props;
---
<Base {...props}>
  <slot name="head" slot="head" />
  <a class="skip m" href="#contenu">Aller au contenu</a>
  <TopBar />
  <main id="contenu" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <div class="crt-scan" aria-hidden="true"></div>
  <div class="crt-noise" aria-hidden="true"></div>
  <Motion />
  {/* Bascule CRT (< 1 Ko) : état mémorisé dans localStorage, réappliqué après un swap de View Transitions. */}
  <script is:inline>(function(){var d=document.documentElement,k='nd-crt';function s(){var o=d.classList.contains('crt-off');document.querySelectorAll('[data-crt]').forEach(function(b){b.setAttribute('aria-pressed',String(!o));var t=b.querySelector('[data-crt-state]');if(t)t.textContent=o?'OFF':'ON'})}function r(){try{d.classList.toggle('crt-off',localStorage.getItem(k)==='off')}catch(e){}s()}r();if(window.__ndcrt)return;window.__ndcrt=1;document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-crt]');if(!b)return;var o=!d.classList.contains('crt-off');d.classList.toggle('crt-off',o);try{localStorage.setItem(k,o?'off':'on')}catch(x){}s()});document.addEventListener('astro:after-swap',r)})();</script>
</Base>
