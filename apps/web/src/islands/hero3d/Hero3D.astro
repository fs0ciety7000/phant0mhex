---
// Contrat (propriétaire : agent motion-3d). Remplit son parent (qui doit être position: relative).
// 1. Poster statique tramé (LCP) : /posters/hero(-m).{webp,png}, rendu headless de la même scène.
// 2. WebGL monté quand le hero approche de l'écran (mount.ts → import dynamique de Three.js), fondu enchaîné.
// Reduced motion ou pas de WebGL2 : poster seul, aucun contexte WebGL.
import { POSTER_READOUT } from './poster';

interface Props {
  /** Libellé HUD haut-gauche. */
  label?: string;
}
const { label = 'OBJ / MONOLITHE-01' } = Astro.props;
---
<div class="hero3d" data-hero3d data-state="poster" aria-hidden="true">
  <div class="hero3d-stage" data-hero3d-stage>
    <picture>
      <source media="(max-width: 599px)" type="image/webp" srcset="/posters/hero-m.webp" width="720" height="1080" />
      <source media="(max-width: 599px)" type="image/png" srcset="/posters/hero-m.png" width="720" height="1080" />
      <source type="image/webp" srcset="/posters/hero.webp" />
      <img
        class="hero3d-poster"
        src="/posters/hero.png"
        width="1920"
        height="780"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <span class="hero3d-xh a"></span><span class="hero3d-xh b"></span><span class="hero3d-xh c"></span><span
    class="hero3d-xh d"
  ></span>
  <div class="hero3d-hud tl">[ {label} ]<br />RENDU : DITHER BAYER 8×8</div>
  <div class="hero3d-hud tr">
    RENDU <output data-hud="fps">--</output> FPS<br />PX <output data-hud="px">3</output>
  </div>
  <div class="hero3d-hud br">
    ROT <output data-hud="rot">{POSTER_READOUT.rot}</output><br />BALAYAGE <output data-hud="sweep"
      >{POSTER_READOUT.sweep}</output
    >
  </div>
</div>

<script>
  import './mount';
</script>

<style>
  .hero3d {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
    contain: layout paint;
  }
  .hero3d-stage {
    position: absolute;
    inset: 0;
  }
  .hero3d-poster,
  .hero3d-stage :global(.hero3d-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero3d-poster {
    object-fit: cover;
    object-position: 50% 50%;
    image-rendering: pixelated;
  }
  .hero3d-stage :global(.hero3d-canvas) {
    opacity: 0;
    transition: opacity 0.6s steps(6);
  }
  .hero3d[data-state='live'] .hero3d-stage :global(.hero3d-canvas) {
    opacity: 1;
  }
  .hero3d-hud {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .hero3d-hud output {
    color: inherit;
  }
  .tl {
    top: 16px;
    left: 20px;
  }
  .tr {
    top: 16px;
    right: 20px;
    text-align: right;
  }
  .br {
    bottom: 16px;
    right: 20px;
    text-align: right;
  }
  .hero3d-xh {
    position: absolute;
    width: 15px;
    height: 15px;
    z-index: 2;
    pointer-events: none;
  }
  .hero3d-xh::before,
  .hero3d-xh::after {
    content: '';
    position: absolute;
    background: var(--fg);
  }
  .hero3d-xh::before {
    left: 7px;
    top: 0;
    width: 1px;
    height: 15px;
  }
  .hero3d-xh::after {
    top: 7px;
    left: 0;
    height: 1px;
    width: 15px;
  }
  .hero3d-xh.a {
    top: -8px;
    left: -8px;
  }
  .hero3d-xh.b {
    top: -8px;
    right: -8px;
  }
  .hero3d-xh.c {
    bottom: -8px;
    left: -8px;
  }
  .hero3d-xh.d {
    bottom: -8px;
    right: -8px;
  }
  @media (max-width: 599px) {
    .br {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero3d-stage :global(.hero3d-canvas) {
      transition: none;
    }
  }
</style>
