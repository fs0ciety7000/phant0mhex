---
import type { Post } from '@nd/pb-types';
import { dateLong, isoDate } from '../lib/format';

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? 'h2' : 'h3';
const cat = post.expand?.category;
const href = `/journal/${post.slug}`;
---
<article class="post">
  <div class="meta mono">
    <time datetime={isoDate(post.published_at)}>{dateLong(post.published_at)}</time>
    {cat && <a href={`/journal/categorie/${cat.slug}`}>{cat.name}</a>}
    {post.reading_time > 0 && <span>{post.reading_time} min</span>}
  </div>
  <H><a href={href}>{post.title}</a></H>
  {post.excerpt && <p>{post.excerpt}</p>}
  <a class="go" href={href} aria-label={`Lire « ${post.title} »`}>Lire le billet →</a>
</article>
