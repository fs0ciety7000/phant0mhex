---
import type { Category, Post } from '@nd/pb-types';
import type { ListResult, LogEntry } from '../lib/data';
import PostCard from './PostCard.astro';

interface Props {
  title: string;
  /** Sous-titre (ex. « Catégorie »). */
  kicker: string;
  result: ListResult<Post>;
  /** Index chronologique (conservé pour compatibilité des appels). */
  index?: LogEntry[];
  categories: Category[];
  /** Slug de catégorie active (puces). */
  activeCategory?: string;
  /** Chemin de base pour la pagination. */
  basePath: string;
  /** Recherche (uniquement sur /journal). */
  search?: { q: string };
  degraded: boolean;
}
const { title, kicker, result, categories, activeCategory, basePath, search, degraded } = Astro.props;

function pageHref(n: number): string {
  const p = new URLSearchParams();
  if (search?.q) p.set('q', search.q);
  if (n > 1) p.set('page', String(n));
  const qs = p.toString();
  return qs ? `${basePath}?${qs}` : basePath;
}
const { page, totalPages, totalItems, items } = result;
---
<section class="wrap" aria-labelledby="h-jou">
  <header class="page-head">
    <p class="mono muted">{kicker} · {totalItems} billet{totalItems > 1 ? 's' : ''}</p>
    <h1 id="h-jou">{title}</h1>
    <p>Notes de fabrication : game design, développement, outils et décisions techniques.</p>
  </header>

  <div class="journal-tools">
    {
      search && (
        <form class="search" role="search" method="get" action="/journal">
          <label class="sr-only" for="q">Rechercher dans le blog</label>
          <input id="q" name="q" type="search" value={search.q} maxlength="80" placeholder="Rechercher un billet" autocomplete="off" />
          <button class="btn" type="submit">Chercher</button>
        </form>
      )
    }
    <nav aria-label="Catégories">
      <ul class="chips">
        <li>
          <a class="chip" href="/journal" aria-current={!activeCategory && !search?.q ? 'page' : undefined}>Tout</a>
        </li>
        {
          categories.map((c) => (
            <li>
              <a class="chip" href={`/journal/categorie/${c.slug}`} aria-current={activeCategory === c.slug ? 'page' : undefined}>
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      search?.q && (
        <p class="muted" role="status">
          {totalItems} résultat{totalItems > 1 ? 's' : ''} pour « {search.q} ». <a href="/journal">Effacer la recherche</a>
        </p>
      )
    }
  </div>

  {
    items.length > 0 ? (
      <div class="post-list">
        {items.map((p) => (
          <PostCard post={p} headingLevel={2} />
        ))}
      </div>
    ) : (
      <div class="empty">
        <b>{degraded ? 'Contenu indisponible.' : search?.q ? 'Aucun billet ne correspond.' : 'Aucun billet pour l’instant.'}</b>
        {degraded ? 'La base de contenu ne répond pas, réessayez dans quelques instants.' : search?.q ? 'Essayez un autre terme ou parcourez les catégories.' : 'Les prochains billets apparaîtront ici.'}
      </div>
    )
  }

  {
    totalPages > 1 && (
      <nav class="pager" aria-label="Pagination">
        <a class="btn" href={page > 1 ? pageHref(page - 1) : undefined} rel="prev" aria-disabled={page <= 1 ? 'true' : undefined}>← Plus récents</a>
        <span class="mono muted">Page {page} sur {totalPages}</span>
        <a class="btn" href={page < totalPages ? pageHref(page + 1) : undefined} rel="next" aria-disabled={page >= totalPages ? 'true' : undefined}>Plus anciens →</a>
      </nav>
    )
  }
</section>
