---
// Page de repli quand PocketBase est injoignable sur une page de détail (réponse 503, jamais mise en cache).
// Le statut 503 + Retry-After est posé par la page appelante (frontmatter), avant le rendu.
interface Props {
  back: { href: string; label: string };
}
const { back } = Astro.props;
---
<section class="lost wrap" aria-labelledby="h-lost">
  <p class="mono muted">Erreur 503</p>
  <h1 id="h-lost">Hors ligne.</h1>
  <p>La base de contenu ne répond pas. Cette page est momentanément indisponible ; réessayez dans quelques instants.</p>
  <div class="cta">
    <a class="btn" href={back.href}>← {back.label}</a>
    <a class="btn" href="/">Accueil</a>
  </div>
</section>
