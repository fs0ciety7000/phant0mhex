---
const path = Astro.url.pathname;
const links = [
  { label: 'Projets', href: '/projets', match: '/projets' },
  { label: 'Blog', href: '/journal', match: '/journal' },
  { label: 'CARDOR Media', href: '/#cardor', match: null },
  { label: 'Contact', href: '/#contact', match: null },
];
const degraded = Astro.locals.degraded;
---
<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Nicolas Dessenius, accueil">Dessenius<span>.</span></a>
    <nav class="site-nav" aria-label="Navigation principale">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={l.match && (path === l.match || path.startsWith(`${l.match}/`)) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    {degraded && <span class="status mono" role="status">Contenu partiellement indisponible</span>}
  </div>
</header>
